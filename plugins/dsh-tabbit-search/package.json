{
  "name": "dsh-tabbit-search",
  "version": "0.1.0",
  "description": "Default Tabbit AI aggregated web search tool for DeepSeek Harness (no DEEPSEEK_API_KEY required)",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tabbit",
    "web-search"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
